{
  "name": "pcmall_backend",
  "version": "1.0.0",
  "description": "PCMall backend",
  "main": "src/server.ts",
  "directories": {
    "test": "test"
  },
  "type": "module",
  "scripts": {
    "start": "bun dist/server.js",
    "build": "tsup src/server.ts --out-dir dist --clean",
    "dev": "npx tsx watch src/server.ts",
    "test:seed": "npx tsx test/scripts/index.ts",
    "test": "npm run test:seed && vitest test",
    "test:run": "npm run test:seed && vitest run",
    "test:coverage": "npm run test:seed && vitest run --coverage",
    "lint": "eslint src/**/*.{js,ts} --fix",
    "lint:check": "eslint src/**/*.{js,ts}",
    "prettier": "npx prettier --write src/**/*.{js,ts,json,md}",
    "prettier:check": "npx prettier --check src/**/*.{js,ts,json,md}",
    "type-check": "tsc --noEmit",
    "audit:security": "npm audit --audit-level=moderate",
    "prepare": "husky init",
    "pre-commit": "lint-staged"
  },
  "keywords": [],
  "author": "Robin Sabhaya",
  "license": "ISC",
  "lint-staged": {
    "*.{js,ts}": [
      "npx eslint --fix",
      "npx prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "npx prettier --write"
    ],
    "package*.json": [
      "npm audit --audit-level=moderate"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx lint-staged",
      "pre-push": "npm run type-check && npm run lint:check",
      "commit-msg": "npx commitlint -E HUSKY_GIT_PARAMS",
      "post-commit": "git log -1 --pretty=format:'✅ Committed: %h - %s (%an)'"
    }
  },
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.5",
    "dotenv": "^17.2.0",
    "ejs": "^3.1.10",
    "eslint-plugin-n": "^17.21.3",
    "fastify": "^5.4.0",
    "fastify-cli": "^7.4.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^5.0.2",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.5",
    "moment": "^2.30.1",
    "mongoose": "^8.16.3",
    "nodemailer": "^7.0.5",
    "redis": "^5.6.0",
    "shippo": "^2.15.0",
    "stripe": "^18.3.0",
    "twilio": "^5.7.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@faker-js/faker": "^9.9.0",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.14",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-optimize-regex": "^1.2.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.4",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
